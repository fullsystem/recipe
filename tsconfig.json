{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,

        // Ordered fallback: the recipe's own file wins, the harness stands in for
        // what a starter kit already provides. vite.config.ts repeats this list —
        // keep the two in step.
        "paths": {
            "@/*": ["./src/resources/js/*", "./workbench/resources/js/*"]
        }
    },
    "include": ["src/resources/js/**/*", "workbench/resources/js/**/*", "vite.config.ts"]
}
